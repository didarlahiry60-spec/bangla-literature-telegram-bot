# Telegram Bot Token (Get this from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Optional: Google Gemini API Key for dynamic AI literature curation
# If left empty, the bot uses its rich curated offline database of Bengali classics
GEMINI_API_KEY=

# Timezone (Default: Asia/Dhaka)
TIMEZONE=Asia/Dhaka

# Database path (Default: subscribers.db in root directory)
DATABASE_PATH=subscribers.db
